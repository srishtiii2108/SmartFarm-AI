APP_NAME="SmartFarm AI API"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# CORS Origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Supabase PostgreSQL & Storage
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_BUCKET="leaf-scans"

# Cohere API (Verified Models)
COHERE_API_KEY=""
COHERE_CHAT_MODEL="command-a-03-2025"
COHERE_EMBED_MODEL="embed-english-v3.0"

# ML Artifact Paths
ML_MODEL_PATH="../ml/artifacts/smartfarm_mobilenetv2_v1.keras"
ML_LABELS_PATH="../ml/artifacts/class_indices.json"
ML_MODEL_VERSION="mobilenetv2-v1.0"